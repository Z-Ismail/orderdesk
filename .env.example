# Copy to .env and fill in. .env is git-ignored; this file is committed as documentation.
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides (defaults live in src/orderdesk/config.py)
# EXTRACTION_MODEL=claude-haiku-5-5
# MAX_OUTPUT_TOKENS=2000
# MAX_CALLS_PER_RUN=50
# MAX_COST_USD_PER_RUN=0.50
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local Postgres from docker-compose.yml
DATABASE_URL=postgresql://orderdesk:orderdesk@localhost:5433/orderdesk

# Simulated ERP (uv run uvicorn orderdesk.erp_sim.app:create_app --factory --port 8100)
ERP_BASE_URL=http://localhost:8100
ERP_READ_KEY=dev-read-key
ERP_WRITE_KEY=dev-write-key
# Chaos switches for the ERP server (leave unset normally)
# ERP_FAULT_RATE=0.3
# ERP_LATENCY_MS=2000

# Web login: true whenever the site is served over HTTPS (production)
SECURE_COOKIES=false

# Public demo only (never on a real deployment: Reset deletes all orders)
DEMO_MODE=false
DEMO_PASSWORD=
